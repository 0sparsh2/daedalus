# Supabase (local: `pnpm db:start` prints these)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Secrets (generate your own)
CREDENTIALS_ENCRYPTION_KEY=   # openssl rand -base64 32
GATEWAY_TOKEN_SECRET=         # openssl rand -hex 32
# GATEWAY_MAX_CALL_MS=280000  # optional: cap on one streamed model call

# Sandboxes: docker locally, vercel in production
SANDBOX_PROVIDER=docker

# Sign-in options shown in the dialog
NEXT_PUBLIC_AUTH_PROVIDERS=email

# Scripted mock model for local development and tests (never in production)
NEXT_PUBLIC_ENABLE_MOCK_PROVIDER=1

# Optional integrations
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VERCEL_DEPLOY_TOKEN=
VERCEL_DEPLOY_TEAM_ID=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
