# Supabase (local: `pnpm db:start` prints these)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Secrets (generate your own)
CREDENTIALS_ENCRYPTION_KEY=   # openssl rand -base64 32
GATEWAY_TOKEN_SECRET=         # openssl rand -hex 32
# GATEWAY_MAX_CALL_MS=280000  # optional: cap on one streamed model call

# Sandboxes: docker locally, vercel in production
SANDBOX_PROVIDER=docker
# SANDBOX_NETWORK=open         # optional: lift the Vercel Sandbox allowlist (npm, GitHub + each project's domains)

# Trace retention: a daily cron clears span inputs and outputs older than this many days
CRON_SECRET=                  # openssl rand -hex 24; Vercel Cron sends it as a bearer token
# TRACE_RETENTION_DAYS=30

# Sign-in options shown in the dialog
NEXT_PUBLIC_AUTH_PROVIDERS=email

# Scripted mock model for local development and tests (never in production)
NEXT_PUBLIC_ENABLE_MOCK_PROVIDER=1

# Optional integrations
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VERCEL_DEPLOY_TOKEN=
VERCEL_DEPLOY_TEAM_ID=
# Web search for the research sub-agent, tried in this order (all optional):
SEARXNG_URL=http://127.0.0.1:8888   # free and keyless: `pnpm search:start` runs SearXNG locally
TAVILY_API_KEY=                     # free tier: 1,000 searches a month, no card (tavily.com)
BRAVE_SEARCH_API_KEY=               # paid: $5 of monthly credit, card required
