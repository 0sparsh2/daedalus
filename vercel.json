{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/chat/route.ts": {
      "supportsCancellation": true
    },
    "src/app/api/chat/[runId]/stream/route.ts": {
      "supportsCancellation": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/retention",
      "schedule": "30 3 * * *"
    }
  ]
}
