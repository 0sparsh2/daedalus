{
  "name": "daedalus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/embed-template.mjs && node scripts/copy-prototype.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/embed-template.mjs && node scripts/copy-prototype.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "sandbox:image": "docker build -f docker/sandbox.Dockerfile -t daedalus-sandbox:latest .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.79",
    "@ai-sdk/deepseek": "3.0.64",
    "@ai-sdk/openai": "4.0.93",
    "@ai-sdk/openai-compatible": "3.0.68",
    "@ai-sdk/provider": "4.0.27",
    "@ai-sdk/react": "4.0.143",
    "@ai-sdk/workflow": "2.0.72",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@vercel/sandbox": "3.8.0",
    "@workflow/serde": "5.0.0",
    "ai": "7.0.140",
    "jose": "6.2.12",
    "next": "16.4.1",
    "octokit": "5.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "workflow": "5.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "supabase": "2.121.0",
    "typescript": "^5",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@10.6.1"
}
